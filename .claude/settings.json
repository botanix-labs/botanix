{
    "enabledPlugins": {
        "claude-mem@thedotmack-claude-mem": true,
        "rust-analyzer-lsp@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true,
        "security-guidance@claude-plugins-official": true,
        "feature-dev@claude-plugins-official": true,
        "ralph-wiggum@anthropics-claude-code": true
    },
    "enableAllProjectMcpServers": true,
    "permissions": {
        "allow": [
            "Bash(cargo test:*)",
            "Bash(cargo check:*)",
            "Bash(cargo tree:*)",
            "Bash(cargo clean:*)",
            "Bash(cargo build:*)",
            "Bash(cargo update:*)",
            "Bash(cargo download:*)",
            "Bash(cargo install:*)",
            "Bash(cargo nextest:*)",
            "Bash(cargo clippy:*)",
            "Bash(cargo fmt:*)",
            "Bash(cargo doc:*)",
            "Bash(cargo audit:*)",
            "Bash(cargo llvm-cov:*)",
            "Bash(cargo metadata:*)",
            "Bash(make:*)",
            "Bash(forge:*)",
            "Bash(pre-commit:*)",
            "Bash(pnpm:*)",
            "Bash(npx:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git branch:*)",
            "Bash(git show:*)",
            "Bash(git rev-parse:*)",
            "Bash(gh:*)",
            "Bash(ls:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(bun run:*)",
            "Bash(bun test:*)",
            "Bash(npx tsc:*)",
            "Bash(tee:*)",
            "Bash(rustup:*)",
            "Bash(wc:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "mcp__ide__getDiagnostics",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:docs.rs)",
            "WebFetch(domain:crates.io)"
