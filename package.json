{
    "name": "botanix",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "scripts": {
        "prettier:fix": "prettier --write \"**/*.@(json|md|sh)\"",
        "prettier:validate": "prettier --check \"**/*.@(json|md|sh)\"",
        "md:lint": "markdownlint -c .markdownlint.json \"**/*.md\" \".github/**/*.md\" -i \"target\" -i \"node_modules\" -i \"CHANGELOG.md\"",
        "md:fix": "markdownlint -c .markdownlint.json \"**/*.md\" \".github/**/*.md\" -i \"target\" -i \"node_modules\" -i \"CHANGELOG.md\" --fix",
        "release": "semantic-release"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^20.3.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/release-notes-generator": "^14.1.0",
        "@semantic-release/github": "^12.0.2",
        "commitlint": "^20.3.1",
        "conventional-changelog-conventionalcommits": "^9.1.0",
        "markdownlint": "^0.40.0",
        "markdownlint-cli": "^0.47.0",
        "prettier": "^3.7.4",
        "prettier-plugin-sh": "^0.18.0",
        "prettier-plugin-toml": "^2.0.6",
        "semantic-release": "^25.0.2"
    },
    "packageManager": "pnpm@10.7.1+sha1.11ea2eb2e09f608614c62db024375b462aa3d861"
}
